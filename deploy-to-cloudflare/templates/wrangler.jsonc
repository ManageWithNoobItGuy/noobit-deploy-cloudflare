{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Becomes part of the URL: https://<name>.<subdomain>.workers.dev
  // lowercase letters, digits and "-" only
  "name": "my-app",
  "main": "src/index.js",
  // Set to TODAY's date (YYYY-MM-DD) for a new project
  "compatibility_date": "YYYY-MM-DD",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Website files (HTML/CSS/JS/images). Use "./dist" after a Vite/React build.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* always goes to the Worker code; everything else is served as a file
    "run_worker_first": ["/api/*"]
  },

  // D1 database. Leave out "database_id": Wrangler (4.45+) creates the
  // database automatically and writes the id back here. Keep it after that.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-app-db",
      "migrations_dir": "migrations"
    }
  ]
}
